# ─────────────────────────────────────────────────────────────
# VN Stock MCP Server - environment variables.
# Data comes from the public (unofficial) 24hmoney.vn API - no upstream API key is needed.
# ─────────────────────────────────────────────────────────────

# [REQUIRED] API key(s) protecting /mcp. Several keys, comma-separated, allow rotation.
# Generate one with:  openssl rand -hex 32
# The server rejects placeholders (anything containing `change-me`, `<` or `>`) and keys shorter than
# 32 characters: /mcp then answers 503 and the reason is logged at startup. Replace the value below.
# Not set -> /mcp answers 503 (fail-closed). Keys are read once at startup: restart after changing them.
# Behind MCP Gateway: store the SAME key in Access Control (API Key provider, e.g. `stock-mcp-key`) and set
# Outbound Auth = API Key, header X-Api-Key. (The AgentBase docs recommend env only for non-sensitive
# configuration; this sample keeps the key in the runtime env because the server must read it - see the README.)
MCP_API_KEYS=change-me-run-openssl-rand-hex-32

# LOCAL DEVELOPMENT ONLY. Lets /mcp work without a key when MCP_API_KEYS is empty.
# NEVER set this on a real runtime. Ignored when keys are configured.
# ALLOW_ANONYMOUS=true

# Listen port (default 8080 - the Agent Runtime contract) and bind address (default 0.0.0.0).
# PORT=8080
# HOST=0.0.0.0

# Override the base URL of the 24hMoney API (only for an internal proxy / mirror)
# STOCK_API_BASE_URL=https://api-finance-t19.24hmoney.vn

# Total time budget (seconds) for the upstream calls of ONE tool call, retries included - default 10
# HTTP_TIMEOUT_SECONDS=10

# Cache TTLs (seconds)
# CACHE_TTL_SECONDS=60               # session data (top stocks, price history, foreign trading)
# SLOW_CACHE_TTL_SECONDS=900         # dividends, business plan, valuation, announcements
# COMPANY_CACHE_TTL_SECONDS=21600    # company directory (6 hours)

# ─────────────────────────────────────────────────────────────
# VN Stock MCP Server — mọi biến đều OPTIONAL (mặc định đã chạy được).
# Không cần API key: dữ liệu từ API công khai của 24hmoney.vn.
# ─────────────────────────────────────────────────────────────

# Ghi đè base URL của API 24hMoney (chỉ dùng khi cần proxy/mirror nội bộ)
# STOCK_API_BASE_URL=https://api-finance-t19.24hmoney.vn

# Timeout (giây) khi gọi API — mặc định 10
# HTTP_TIMEOUT_SECONDS=10

# TTL cache (giây) — dữ liệu phiên thay đổi nhanh, mặc định 60
# CACHE_TTL_SECONDS=60

# ─────────────────────────────────────────────────────────────
# VN Stock MCP Server — biến môi trường.
# Dữ liệu từ API công khai (không chính thức) của 24hmoney.vn — không cần API key upstream.
# ─────────────────────────────────────────────────────────────

# [BẮT BUỘC] API key bảo vệ /mcp. Nhiều key cách nhau bởi dấu phẩy (xoay vòng).
# Sinh key:  openssl rand -hex 32
# Không đặt → /mcp trả 503 (fail-closed). Khi nối qua MCP Gateway: lưu CÙNG key này
# vào Access Control (API Key provider, vd `stock-mcp-key`) và đặt Outbound Auth = API Key,
# header X-Api-Key. (Docs khuyên env chỉ cho cấu hình không nhạy cảm — sample này đặt
# key ở env runtime vì server cần đọc nó; xem README.)
MCP_API_KEYS=<openssl rand -hex 32>

# ⚠️ CHỈ DÙNG LOCAL DEV. Cho phép /mcp không cần key khi MCP_API_KEYS trống.
# TUYỆT ĐỐI KHÔNG đặt trên runtime thật.
# ALLOW_ANONYMOUS=true

# Cổng lắng nghe — mặc định 8080 (contract của Agent Runtime)
# PORT=8080

# Ghi đè base URL của API 24hMoney (chỉ khi cần proxy/mirror nội bộ)
# STOCK_API_BASE_URL=https://api-finance-t19.24hmoney.vn

# Timeout (giây) khi gọi API — mặc định 10
# HTTP_TIMEOUT_SECONDS=10

# TTL cache (giây)
# CACHE_TTL_SECONDS=60               # dữ liệu phiên (top stocks, giá, ngoại)
# SLOW_CACHE_TTL_SECONDS=900         # cổ tức, kế hoạch, định giá, tin công bố
# COMPANY_CACHE_TTL_SECONDS=21600    # danh bạ công ty (6 giờ)

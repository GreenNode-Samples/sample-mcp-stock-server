# TLS reverse proxy for the MCP server (used by docker-compose.tls.yml).
# CADDY_SITE = the vServer's private IP (xx.xx.x.x) or an internal hostname.
{
	# Do not request a public certificate (ACME) - the vServer sits in a private network.
	auto_https disable_redirects
}

https://{$CADDY_SITE}:8443 {
	# The certificate is issued by Caddy's own internal CA. The gateway must trust that CA
	# -> confirm with GreenNode how to import a custom CA into the connector.
	tls internal

	# Or use a certificate from your enterprise CA (mount ./certs, see docker-compose.tls.yml):
	# tls /certs/server.crt /certs/server.key

	reverse_proxy mcp:8080 {
		# MCP streamable HTTP: flush data immediately, no buffering
		flush_interval -1
	}
}

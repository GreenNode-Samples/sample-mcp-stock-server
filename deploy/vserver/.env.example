# ─────────────────────────────────────────────────────────────
# Environment for docker compose on the vServer.
# Copy to `.env` (it is gitignored) and fill in real values:
#   cp .env.example .env && chmod 600 .env
# ─────────────────────────────────────────────────────────────

# [REQUIRED] API key protecting /mcp. Several keys, comma-separated, allow rotation.
# Generate one with:  openssl rand -hex 32
# The server rejects placeholders and keys shorter than 32 characters (/mcp then answers 503),
# so replace the value below. Store the SAME key in Access Control (API Key provider) so that
# the gateway sends it in the X-Api-Key header.
MCP_API_KEYS=change-me-run-openssl-rand-hex-32

# Image: keep the default to build from the repo's Dockerfile (docker compose build),
# or point to an image pushed to vCR (docker compose pull).
# MCP_IMAGE=vcr.vngcloud.vn/<repo>/stock-mcp-server:v1

# Host address / port that the container port is published on.
# - Without TLS the gateway calls http://xx.xx.x.x:8080/mcp directly -> keep the defaults.
# - With the Caddy TLS override set BIND_ADDR=127.0.0.1 so that only Caddy (8443) is exposed.
# BIND_ADDR=0.0.0.0
# MCP_PORT=8080

# Only for the Caddy TLS override (docker-compose.tls.yml): the vServer's private IP and the TLS port.
# CADDY_SITE=xx.xx.x.x
# TLS_PORT=8443

# More optional settings (see the main README): STOCK_API_BASE_URL, HTTP_TIMEOUT_SECONDS, CACHE_TTL_SECONDS, ...

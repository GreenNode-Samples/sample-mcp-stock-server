# Copy thành `.env` (nằm trong .gitignore): cp .env.example .env && chmod 600 .env

# [BẮT BUỘC] API key bảo vệ /mcp (nhiều key cách nhau bởi dấu phẩy). Sinh: openssl rand -hex 32
# Lưu CÙNG key vào Access Control (API Key provider) của AgentBase.
MCP_API_KEYS=<openssl rand -hex 32>

# IP của interface NỘI BỘ trong data center để lắng nghe (KHÔNG dùng 0.0.0.0 nếu host có NIC public).
BIND_ADDR=xx.xx.x.x
MCP_PORT=8080

# Image: build từ Dockerfile repo, hoặc image kéo từ vCR / registry nội bộ
# MCP_IMAGE=vcr.vngcloud.vn/<repo>/stock-mcp-server:v1

# Nếu data center không ra được Internet: trỏ tới proxy/mirror nội bộ của API 24hMoney
# STOCK_API_BASE_URL=https://api-finance-t19.24hmoney.vn

# Copy to `.env` (gitignored):  cp .env.example .env && chmod 600 .env

# [REQUIRED] API key protecting /mcp (several keys, comma-separated, allow rotation). Generate: openssl rand -hex 32
# The server rejects placeholders and keys shorter than 32 characters (/mcp then answers 503),
# so replace the value below. Store the SAME key in AgentBase Access Control (API Key provider).
MCP_API_KEYS=change-me-run-openssl-rand-hex-32

# IP of the INTERNAL interface in the data center to listen on (do NOT use 0.0.0.0 if the host has a public NIC).
BIND_ADDR=10.0.0.10
MCP_PORT=8080

# Image: build from the repo's Dockerfile, or pull from vCR / an internal registry
# MCP_IMAGE=vcr.vngcloud.vn/<repo>/stock-mcp-server:v1

# If the data center has no Internet access: point to an internal proxy / mirror of the 24hMoney API
# STOCK_API_BASE_URL=https://api-finance-t19.24hmoney.vn
